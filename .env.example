# Copy to .env for local use. Never commit .env.
POSTGRES_USER=bank
POSTGRES_PASSWORD=bank_local_pw
POSTGRES_DB=bank
DATABASE_URL=postgres://bank:bank_local_pw@localhost:5432/bank

# Service URLs used by the test suites (local compose defaults)
ACCOUNTS_URL=http://localhost:3001
TRANSFERS_URL=http://localhost:3002
CHAT_URL=http://localhost:3003
WEB_URL=http://localhost:8080

# Inquiry chat: LLM + embeddings provider. mock = deterministic OpenAI-compatible mock server
LLM_PROVIDER=mock
LLM_BASE_URL=http://localhost:3004/v1
LLM_API_KEY=mock-key-not-a-secret
LLM_MODEL=mock-1
EMBEDDING_MODEL=mock-hash-256

# Cloud (Bedrock) - values come from AWS Secrets Manager in the cloud
AWS_PROFILE=bank-qa-automation-deployer
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Seeded bug: 1 makes transfer fees round wrongly
SUT_BUG_ROUNDING=0
